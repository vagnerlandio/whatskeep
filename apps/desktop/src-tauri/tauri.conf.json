{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsKeep",
  "version": "0.1.0",
  "identifier": "com.whatskeep.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter export-shell build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter export-shell build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhatsKeep",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "freezePrototype": false,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' wkmedia: http://wkmedia.localhost",
        "media-src": "'self' wkmedia: http://wkmedia.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: wkmedia: http://wkmedia.localhost",
        "media-src": "'self' blob: wkmedia: http://wkmedia.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Your WhatsApp conversations, safe and accessible.",
    "longDescription": "WhatsKeep imports WhatsApp and WhatsApp Business backups (Google Drive or a local copy), decrypts them on your computer and keeps them in an encrypted vault, with a WhatsApp-like viewer and an optional encrypted offline HTML export.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
