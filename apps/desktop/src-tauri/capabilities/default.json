{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. No devtools, no window queries, no event emitting. Each app command is allowed here one by one.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-vault-change-password",
    "allow-vault-usage",
    "allow-vault-delete",
    "allow-store-delete",
    "allow-contacts-info",
    "allow-contacts-import",
    "allow-contacts-remove",
    "allow-list-stores",
    "allow-inspect-backup",
    "allow-import-backup",
    "allow-list-chats",
    "allow-set-chat-pinned",
    "allow-get-messages",
    "allow-get-messages-around",
    "allow-search-messages",
    "allow-gdrive-login",
    "allow-gdrive-login-manual",
    "allow-gdrive-cancel",
    "allow-gdrive-download",
    "allow-import-media-folder",
    "allow-media-cancel",
    "allow-save-media",
    "allow-export-pick-destination",
    "allow-export-html",
    "allow-export-cancel",
    "allow-open-link",
    "allow-ui-log",
    "allow-get-language",
    "allow-set-language"
  ]
}
